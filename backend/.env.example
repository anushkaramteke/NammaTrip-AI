# NammaTrip AI - Backend Environment Configuration Example
# Copy this file to backend/.env and insert your real Gemini API key.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_api_key_here

# Optional: Specify model (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
